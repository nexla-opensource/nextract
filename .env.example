# Rename to .env and fill in as needed

# Used by providers
OPENAI_API_KEY=
GEMINI_API_KEY=
NEXTRACT_API_KEY=
# rag_chunking (RagDocumentChunker) reads GOOGLE_API_KEY, then GEMINI_API_KEY.
# By default the key is treated as a Vertex Agent-Platform express-mode key
# (use_vertex=True); pass use_vertex=False for a plain Gemini Developer key.
GOOGLE_API_KEY=

# Optional: Ollama host if not default
OLLAMA_HOST=http://localhost:11434

# Core nextract configuration (optional)
NEXTRACT_MODEL=
NEXTRACT_MAX_CONCURRENCY=4
NEXTRACT_MAX_RUN_RETRIES=5
NEXTRACT_PER_CALL_TIMEOUT_SECS=120
NEXTRACT_PRICING=
NEXTRACT_MAX_VALIDATION_ROUNDS=2

# Rename to .env and fill in as needed

# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
CO_API_KEY=

# AWS Credentials (for Bedrock and Textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Local/Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Core nextract configuration (optional)
NEXTRACT_MODEL=
NEXTRACT_API_KEY=
NEXTRACT_MAX_CONCURRENCY=4
NEXTRACT_MAX_RUN_RETRIES=5
NEXTRACT_PER_CALL_TIMEOUT_SECS=120
NEXTRACT_PRICING=
NEXTRACT_MAX_VALIDATION_ROUNDS=2
